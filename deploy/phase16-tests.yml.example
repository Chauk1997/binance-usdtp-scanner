name: Phase16 and legacy regression tests
on:
  pull_request:
    paths:
      - '**.py'
      - 'requirements*.txt'
      - '.github/workflows/phase16-tests.yml'
permissions:
  contents: read
jobs:
  tests:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      SCANNER_SCHEDULER_ENABLED: '0'
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.txt -r requirements-mcp.txt pytest
      - run: python -m pytest -q
